# Fill these directly in your private host environment. Never commit .env or credentials.
NODE_ENV=production
PORT=3000
# Existing mounted volume path, not a newly-created empty database path:
DB_PATH=/your-existing-mounted-volume/beautydesk.db
PUBLIC_BASE_URL=https://beautydesk-production.up.railway.app
# Supply strong independent values securely. Missing/short values stop startup:
JWT_SECRET=
ADMIN_PASSCODE=
# Exact App Secret from the Meta app that sends this number's webhooks.
# Without it, incoming POST callbacks return 503 and no messages are processed.
META_APP_SECRET=
# Optional: guided booking works without a provider key.
ANTHROPIC_API_KEY=
# Optional photo pilot. Keep disabled until separately authorized and live-tested.
PHOTO_ESTIMATES_ENABLED=false
PHOTO_VISION_MODEL=
PHOTO_PRIVACY_URL=
