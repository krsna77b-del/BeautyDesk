# Fill these directly in your private host environment. Never commit .env or credentials.
NODE_ENV=production
PORT=3000
# Existing mounted volume path, not a newly-created empty database path:
DB_PATH=/your-existing-mounted-volume/beautydesk.db
PUBLIC_BASE_URL=https://beautydesk-production.up.railway.app
# Supply strong independent values securely. Missing/short values stop startup:
JWT_SECRET=
ADMIN_PASSCODE=
# Exact App Secret from the Meta app that sends this number's webhooks.
# Without it, incoming POST callbacks return 503 and no messages are processed.
META_APP_SECRET=
# Optional: guided booking works without a provider key.
ANTHROPIC_API_KEY=
# Optional photo pilot. Keep disabled until separately authorized and live-tested.
PHOTO_ESTIMATES_ENABLED=false
PHOTO_VISION_MODEL=
PHOTO_PRIVACY_URL=

# Separate private Google hairstyle-preview pilot; all settings remain disabled.
# Owner enters the Google key directly in the private host UI, never source/chat.
# GOOGLE_HAIRSTYLE_API_KEY=
HAIRSTYLE_PREVIEW_ENABLED=false
HAIRSTYLE_PREVIEW_MODEL=gemini-nano-banana-2.1
# Exact existing salon client ID; no public or wildcard access.
HAIRSTYLE_PREVIEW_PILOT_CLIENT_ID=
# Explicit owner-reviewed disclosure version.
HAIRSTYLE_PREVIEW_NOTICE_VERSION=
# Analysis model is pinned in source to gemini-3.5-flash-lite.
# Two sets maximum; each reserves four calls ($1.60), total $3.20. No auto retries.
